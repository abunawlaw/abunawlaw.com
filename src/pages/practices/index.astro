---
import Base from '../../layouts/Base.astro';
---
<Base title="Practices" description="Core practice areas of Abunaw & Associates, advising under Cameroonian, OHADA and CEMAC law from Douala and Buea.">
<div>
  <section style="max-width:1360px;margin:0 auto;padding:clamp(56px,8vw,120px) clamp(20px,5vw,80px) clamp(40px,5vw,64px)">
    <div style="font-size:11px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:#007EA7;margin-bottom:28px">Practices</div>
    <h1 style="font-family:Spectral,Georgia,serif;font-weight:300;font-size:clamp(36px,5vw,64px);line-height:1.08;letter-spacing:-0.02em;margin:0;max-width:22ch">Core practice areas</h1>
    <p style="font-size:17.5px;line-height:1.75;color:#38484f;max-width:66ch;margin:32px 0 0">We advise businesses, organisations and individuals from our offices in Douala and Buea, working in English and French under Cameroonian, OHADA and CEMAC law.</p>
  </section>
  <section style="max-width:1360px;margin:0 auto;padding:0 clamp(20px,5vw,80px) clamp(40px,5vw,72px);border-top:1px solid rgba(0,23,31,0.14)">
