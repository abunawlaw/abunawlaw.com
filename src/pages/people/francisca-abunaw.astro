---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import francisca from '../../assets/people/francisca-abunaw.png';
---
<Base title="Francisca E. Abunaw" description="Francisca E. Abunaw, Managing Partner of Abunaw & Associates.">
<div>
  <section style="max-width:1360px;margin:0 auto;padding:clamp(40px,6vw,88px) clamp(20px,5vw,80px) clamp(56px,7vw,96px)">
    <a href="/people/" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#007EA7;margin-bottom:32px">← People</a>
    <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(28px,3vw,48px)">
      <div style="grid-column:span 4;min-width:230px">
        <div style="position:relative;aspect-ratio:4/5;background:#e7ebed;overflow:hidden"><Image src={francisca} alt="Francisca E. Abunaw" width={1200} style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;filter:grayscale(1) contrast(1.06) brightness(0.98)" /></div>
        <div style="border-top:1px solid rgba(0,23,31,0.16);margin-top:24px;padding-top:18px;display:grid;gap:16px">
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Office</div><div style="font-size:15px;color:#00171F">Douala</div></div>
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Admissions</div><div style="font-size:15px;line-height:1.55;color:#00171F">Cameroon Bar Association<br />Nigerian Bar</div></div>
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Contact</div><div style="font-family:ui-monospace,Menlo,monospace;font-size:13px;line-height:1.7;color:#6b7b82"><a href="mailto:francisca.abunaw@abunawlaw.com" style="font-family:Archivo,Helvetica,sans-serif;font-size:14px">francisca.abunaw@abunawlaw.com</a><br />[+237 telephone]</div></div>
        </div>
      </div>
      <div style="grid-column:span 7;min-width:280px">
        <h1 style="font-family:Spectral,Georgia,serif;font-weight:300;font-size:clamp(34px,4.4vw,56px);line-height:1.08;letter-spacing:-0.02em;margin:0">Francisca E. Abunaw</h1>
        <div style="font-size:16px;color:#38484f;margin:14px 0 0">Managing Partner</div>
        <p style="font-family:Spectral,Georgia,serif;font-size:clamp(19px,1.7vw,22px);line-height:1.55;color:#00171F;margin:32px 0 22px;max-width:60ch;text-wrap:pretty">Francisca Abunaw is the Managing Partner of Abunaw &amp; Associates. She advises companies on commercial contracts, corporate compliance and structuring, and succession matters, with particular depth in OHADA and CEMAC law.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">Admitted to practise in both Cameroon and Nigeria, Francisca has six years of experience in legal practice. She has advised more than 30 companies across banking and finance, payments, telecommunications, logistics, and oil and gas, on matters including corporate structuring and restructuring, commercial transactions, labour law, data protection, consumer protection and real estate. She has guided around 12 businesses through incorporation.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">Before founding the firm, Francisca was an Associate Attorney at Etah-Nan &amp; Co. She has also acted as consultant to human resources firms and non-governmental organisations, reviewing and strengthening their internal governance frameworks — work that informs her approach to compliance and organisational policy.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">Her practice also includes legal translation, allowing clients to rely on documents that hold their meaning across English and French.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">Francisca is the founder of <em>The Law Demystified</em>, a platform that makes legal concepts accessible to a wider audience.</p>
        <section style="margin-top:40px;padding-top:24px;border-top:1px solid rgba(0,23,31,0.16)"><h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:24px;margin:0 0 16px">Practice focus</h2><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 28px"><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Contract drafting and review</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Corporate compliance and governance</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Corporate structuring and restructuring</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Incorporation</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Labour and employment</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Data protection</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Consumer protection</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Real estate</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Succession</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Legal translation</li></ul></section>
        <section style="margin-top:40px;padding-top:24px;border-top:1px solid rgba(0,23,31,0.16)"><h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:24px;margin:0 0 16px">Sectors</h2><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 28px"><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Banking and finance</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Payments</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Telecommunications</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Logistics</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Oil and gas</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Non-profit and NGOs</li></ul></section>
      </div>
    </div>
  </section>
</div>
</Base>
