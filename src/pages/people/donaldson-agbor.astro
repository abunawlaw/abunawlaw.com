---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import donaldson from '../../assets/people/donaldson-agbor.jpeg';
---
<Base title="Orock Donaldson Agbor" description="Orock Donaldson Agbor, Associate, Buea office.">
<div>
  <section style="max-width:1360px;margin:0 auto;padding:clamp(40px,6vw,88px) clamp(20px,5vw,80px) clamp(56px,7vw,96px)">
    <a href="/people/" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#007EA7;margin-bottom:32px">← People</a>
    <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(28px,3vw,48px)">
      <div style="grid-column:span 4;min-width:230px">
        <div style="position:relative;aspect-ratio:4/5;background:#e7ebed;overflow:hidden"><Image src={donaldson} alt="Orock Donaldson Agbor" width={1200} style="position:absolute;width:200%;max-width:none;left:-85%;top:-30%;filter:grayscale(1) contrast(1.06) brightness(0.98)" /></div>
        <div style="border-top:1px solid rgba(0,23,31,0.16);margin-top:24px;padding-top:18px;display:grid;gap:16px">
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Office</div><div style="font-size:15px;color:#00171F">Buea</div></div>
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Admissions</div><div style="font-size:15px;line-height:1.55;color:#00171F">Advocate of the Supreme Court of Cameroon<br />Nigerian Bar Association</div></div>
          <div><div style="font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#6b7b82;margin-bottom:5px">Contact</div><div style="font-family:ui-monospace,Menlo,monospace;font-size:13px;line-height:1.7;color:#6b7b82"><a href="mailto:donaldson.agbor@abunawlaw.com" style="font-family:Archivo,Helvetica,sans-serif;font-size:14px">donaldson.agbor@abunawlaw.com</a><br />[+237 telephone]</div></div>
        </div>
      </div>
      <div style="grid-column:span 7;min-width:280px">
        <h1 style="font-family:Spectral,Georgia,serif;font-weight:300;font-size:clamp(34px,4.4vw,56px);line-height:1.08;letter-spacing:-0.02em;margin:0">Orock Donaldson Agbor</h1>
        <div style="font-size:16px;color:#38484f;margin:14px 0 0">Associate</div>
        <p style="font-family:Spectral,Georgia,serif;font-size:clamp(19px,1.7vw,22px);line-height:1.55;color:#00171F;margin:32px 0 22px;max-width:60ch;text-wrap:pretty">Orock Donaldson Agbor is an Associate in the firm’s Buea office. His practice spans criminal litigation, probate, land law and succession.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">An Advocate of the Supreme Court of Cameroon and a member of the Nigerian Bar Association, Donaldson has five years of legal practice. He acts for clients in matters ranging from criminal defence to estate administration and property disputes.</p>
        <p style="font-size:17px;line-height:1.75;color:#28383f;margin:0 0 18px;max-width:66ch;text-wrap:pretty">He is known for a meticulous approach to dispute resolution, pairing courtroom advocacy with close attention to procedure — an approach that makes him a trusted adviser to clients in complex and contested matters.</p>
        <section style="margin-top:40px;padding-top:24px;border-top:1px solid rgba(0,23,31,0.16)"><h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:24px;margin:0 0 16px">Practice focus</h2><ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 28px"><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Criminal litigation and defence</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Probate and estate administration</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Land law and property disputes</li><li style="font-size:15.5px;line-height:1.5;color:#28383f;border-top:1px solid rgba(0,23,31,0.1);padding-top:10px">Succession</li></ul></section>
      </div>
    </div>
  </section>
</div>
</Base>
