---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import francisca from '../../assets/people/francisca-abunaw.png';
---
<Base description="Abunaw & Associates, cabinet camerounais à Douala et Buea : conseil en environnement OHADA, en anglais et en français." lang="fr">
<div>
  <section style="background:#00171F;color:#FFFFFF;position:relative;overflow:hidden">
    <div style="position:absolute;inset:0;display:flex;justify-content:flex-end">
      <div style="position:relative;width:min(72%,980px);height:100%">
        <Image src={francisca} alt="" loading="eager" width={1600} style="width:100%;height:100%;object-fit:cover;object-position:50% 16%;filter:grayscale(1) contrast(1.12) brightness(0.72)" />
        <div style="position:absolute;inset:0;background:#003459;mix-blend-mode:color;opacity:0.9"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(90deg,#00171F 0%,#00171F 26%,rgba(0,23,31,0.86) 52%,rgba(0,23,31,0.2) 100%)"></div>
      </div>
    </div>
    <div style="position:relative;max-width:1360px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,5vw,80px) clamp(48px,6vw,88px);min-height:clamp(560px,76vh,820px);display:flex;flex-direction:column;justify-content:center">
      <div style="font-size:11px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:#00A8E8;margin-bottom:clamp(24px,4vw,44px)">Douala · Buea</div>
      
      
        <h1 style="font-family:Spectral,Georgia,serif;font-weight:300;font-size:clamp(56px,11vw,168px);line-height:0.94;letter-spacing:-0.035em;margin:0">Intégrité.<br />Résultats.</h1>
        <p style="font-size:clamp(17px,1.5vw,21px);line-height:1.6;color:rgba(255,255,255,0.86);max-width:44ch;margin:clamp(28px,4vw,48px) 0 0;text-wrap:pretty">Conseil en environnement OHADA. Cabinet camerounais au service des entreprises, des établissements de crédit et des familles, en anglais et en français, dans les deux traditions juridiques du pays.</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:clamp(32px,4vw,48px)">
          <a href="/practices/" class="lnk" style="background:#FFFFFF;color:#00171F;border:0;padding:14px 26px;cursor:pointer;font-size:14px;font-weight:500;letter-spacing:0.04em;white-space:nowrap">Nos domaines</a>
          <a href="/contact/" class="lnk" style="background:none;color:#FFFFFF;border:1px solid rgba(255,255,255,0.45);padding:14px 26px;cursor:pointer;font-size:14px;font-weight:500;letter-spacing:0.04em;white-space:nowrap">Contacter le cabinet</a>
        </div>
      
    </div>
  </section>

  <hr style="border:0;border-top:1px solid rgba(0,23,31,0.14);margin:0" />

  <section data-reveal="1" style="max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,5vw,80px)">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:24px;flex-wrap:wrap;margin-bottom:clamp(28px,4vw,48px)">
      <h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:clamp(24px,2.6vw,34px);line-height:1.2;margin:0">Areas of practice</h2>
      <a href="/practices/" class="lnk" style="background:none;border:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;border-bottom:1px solid #007EA7;padding:0 0 2px">All practices</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:36px 32px">
      <div style="border-top:2px solid #00171F;padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">01</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Corporate &amp; Commercial</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Corporate structuring and restructuring · Commercial transactions · Company incorporation / business formation</p>
        <a href="/practices/corporate/" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;text-align:left">Read more</a>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">02</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Corporate Compliance &amp; Governance</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Regulatory compliance advisory · Corporate governance frameworks · Tax compliance · AML compliance · Data protection · NGO/organizational policy review</p>
        <a href="/practices/corporate/#regulatory" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;text-align:left">Read more</a>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">03</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Succession &amp; Probate</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Succession planning · Letters of administration · Probate matters</p>
        <a href="/practices/succession-probate/" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;text-align:left">Read more</a>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">04</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Real Estate &amp; Land Law</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Property transactions · Land law advisory</p>
        <a href="/practices/real-estate-land/" class="lnk" style="background:none;border:0;padding:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;text-align:left">Read more</a>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">05</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Labour &amp; Employment Law</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Employment contracts and disputes · Workplace compliance</p>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">06</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Family Law</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Family law matters and representation</p>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">07</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Criminal Litigation</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Criminal defense and litigation</p>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">08</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Human Rights Law</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Human rights advocacy and representation</p>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">09</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Consumer Protection</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Consumer rights advisory</p>
      </div>
      <div style="border-top:1px solid rgba(0,23,31,0.2);padding-top:18px;display:flex;flex-direction:column;gap:10px">
        <span style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#007EA7">10</span>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0">Legal Translation</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#4a5a61;margin:0">Legal document translation (English/French)</p>
      </div>
    </div>
  </section>

  <hr style="border:0;border-top:1px solid rgba(0,23,31,0.14);margin:0" />

  <section data-reveal="1" style="max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,80px)">
    <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:32px">
      <div style="grid-column:span 4;min-width:220px">
        <h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:clamp(26px,3vw,40px);line-height:1.15;margin:0;max-width:16ch">Why Cameroon, why common law</h2>
      </div>
      <div style="grid-column:span 7;min-width:280px">
        <p style="font-size:17.5px;line-height:1.75;color:#28383f;margin:0 0 20px;max-width:68ch;text-wrap:pretty">Cameroon is bijural. Common law applies in the Northwest and Southwest regions; civil law applies elsewhere. Above both sit the OHADA Uniform Acts, which govern company law, secured transactions, insolvency and commercial arbitration nationwide.</p>
        <p style="font-size:17.5px;line-height:1.75;color:#28383f;margin:0 0 20px;max-width:68ch;text-wrap:pretty">For an investor arriving from London, Lagos, Accra or Nairobi, that combination is unfamiliar. Documents are drafted to common-law expectations; the register, the courts and the security regime are OHADA. Our lawyers work on both sides of that line, in both working languages, without translation loss.</p>
        <p style="font-size:17.5px;line-height:1.75;color:#28383f;margin:0;max-width:68ch;text-wrap:pretty">We also act for Cameroonian companies going the other way — into CEMAC and ECOWAS markets, and into common-law jurisdictions where local counsel needs a partner who understands what was agreed at home.</p>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="background:#00171F;color:#FFFFFF">
    <div style="max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,5vw,80px)">
      <div style="font-size:11px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:#00A8E8;margin-bottom:clamp(28px,4vw,48px)">Experience</div>
      <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:32px">
        <p style="grid-column:span 4;min-width:230px;font-family:Spectral,Georgia,serif;font-size:clamp(19px,1.8vw,23px);line-height:1.5;margin:0;padding-top:20px;border-top:1px solid rgba(255,255,255,0.28)">More than 30 companies advised across banking and finance, payments, telecommunications, logistics, and oil and gas.</p>
        <p style="grid-column:span 4;min-width:230px;font-family:Spectral,Georgia,serif;font-size:clamp(19px,1.8vw,23px);line-height:1.5;margin:0;padding-top:20px;border-top:1px solid rgba(255,255,255,0.28)">Around 12 businesses guided through incorporation and formation.</p>
        <p style="grid-column:span 4;min-width:230px;font-family:Spectral,Georgia,serif;font-size:clamp(19px,1.8vw,23px);line-height:1.5;margin:0;padding-top:20px;border-top:1px solid rgba(255,255,255,0.28)">Internal governance frameworks reviewed and strengthened for human resources firms and NGOs.</p>
      </div>
    </div>
  </section>

  <section data-reveal="1" style="max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,5vw,80px)">
    <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:32px">
      <div style="grid-column:span 4;min-width:220px;border-top:1px solid rgba(0,23,31,0.2);padding-top:20px">
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:22px;margin:0 0 10px">Douala</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#4a5a61;margin:0">Head office<br /><span style="font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#6b7b82">[street address]</span><br /><span style="font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#6b7b82">[+237 telephone]</span></p>
      </div>
      <div style="grid-column:span 4;min-width:220px;border-top:1px solid rgba(0,23,31,0.2);padding-top:20px">
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:22px;margin:0 0 10px">Buea</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#4a5a61;margin:0">Southwest Region<br /><span style="font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#6b7b82">[street address]</span><br /><span style="font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#6b7b82">[+237 telephone]</span></p>
      </div>
      <div style="grid-column:span 4;min-width:220px;padding-top:20px">
        <a href="/contact/" class="lnk" style="background:none;border:1px solid rgba(0,23,31,0.22);padding:12px 18px;cursor:pointer;font-size:13.5px;font-weight:500;color:#00171F">Contact the firm</a>
      </div>
    </div>
  </section>

  <hr style="border:0;border-top:1px solid rgba(0,23,31,0.14);margin:0" />

  <section data-reveal="1" style="max-width:1360px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,5vw,80px)">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:24px;flex-wrap:wrap;margin-bottom:clamp(24px,3vw,40px)">
      <h2 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:clamp(24px,2.6vw,34px);margin:0">Insights</h2>
      <a href="/insights/" class="lnk" style="background:none;border:0;cursor:pointer;font-size:13.5px;font-weight:500;color:#007EA7;border-bottom:1px solid #007EA7;padding:0 0 2px">All insights</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:32px">
      <a href="/insights/registering-security-at-the-rccm/" class="card" style="grid-column:span 4;min-width:240px;text-align:left;background:none;border:0;border-top:1px solid rgba(0,23,31,0.2);padding:20px 0 0;cursor:pointer">
        <div style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#6b7b82;margin-bottom:12px">[month year] · Finance</div>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.3;margin:0;color:#00171F;max-width:32ch">Registering security at the RCCM: what lenders get wrong</h3>
      </a>
      <div style="grid-column:span 4;min-width:240px;text-align:left;background:none;border:0;border-top:1px solid rgba(0,23,31,0.2);padding:20px 0 0">
        <div style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#6b7b82;margin-bottom:12px">[month year] · Land</div>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.3;margin:0;color:#00171F;max-width:32ch">Customary tenure and registered title in the Southwest</h3>
      </div>
      <div style="grid-column:span 4;min-width:240px;text-align:left;background:none;border:0;border-top:1px solid rgba(0,23,31,0.2);padding:20px 0 0">
        <div style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#6b7b82;margin-bottom:12px">[month year] · Corporate</div>
        <h3 style="font-family:Spectral,Georgia,serif;font-weight:400;font-size:21px;line-height:1.3;margin:0;color:#00171F;max-width:32ch">Choosing between an SA, a SARL and an SAS</h3>
      </div>
    </div>
  </section>
</div>
</Base>
